# Maintainer: Anwar Ahmed <anwar dot ahmed at gmail dot com>
#
# Generated by packaging/aur/render.sh in https://github.com/anwarahmed/fungeo
# for each release; edit the template there, not this file.

pkgname=fungeo-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="A geography quiz for children, in the terminal: build a bridge, one right answer at a time"
arch=('x86_64' 'aarch64')
url="https://github.com/anwarahmed/fungeo"
license=('MIT')
provides=('fungeo')
conflicts=('fungeo')
# The binaries are static and already stripped of debug info.
options=('!strip' '!debug')
source=("fungeo-$pkgver-LICENSE::https://raw.githubusercontent.com/anwarahmed/fungeo/v$pkgver/LICENSE")
source_x86_64=("fungeo-$pkgver-x86_64::$url/releases/download/v$pkgver/fungeo-x86_64-unknown-linux-musl")
source_aarch64=("fungeo-$pkgver-aarch64::$url/releases/download/v$pkgver/fungeo-aarch64-unknown-linux-musl")
sha256sums=('@SHA_LICENSE@')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
    install -Dm755 "$srcdir/fungeo-$pkgver-$CARCH" "$pkgdir/usr/bin/fungeo"
    install -Dm644 "$srcdir/fungeo-$pkgver-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # pacman owns this copy: the marker tells the game never to update itself. It looks
    # for it at ../share/fungeo/managed-by from the directory of its binary.
    install -d "$pkgdir/usr/share/fungeo"
    echo "pacman; update the fungeo-bin package" > "$pkgdir/usr/share/fungeo/managed-by"
}
